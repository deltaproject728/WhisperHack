local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Camera           = workspace.CurrentCamera
local LocalPlayer      = Players.LocalPlayer

-- ═══════════════════════════════════════
-- [ 0 ] LOG SUPPRESSOR
-- ═══════════════════════════════════════
local function safeHook(fn)
    pcall(fn)
end

safeHook(function()
    local ow = warn
    warn = function(...)
        local m = tostring(select(1,...)):lower()
        if m:find("asset") or m:find("sound") or m:find("rbxasset")
        or m:find("authorized") or m:find("approved") or m:find("channel") then return end
        return ow(...)
    end
end)

safeHook(function()
    local CP  = game:GetService("ContentProvider")
    local old = CP.PreloadAsync
    CP.PreloadAsync = function(self, assets, cb)
        return pcall(old, self, assets, cb)
    end
end)

-- ═══════════════════════════════════════
-- [ 1 ] ANTI-DETECTION
-- ═══════════════════════════════════════
safeHook(function()
    if syn and syn.set_thread_identity then
        syn.set_thread_identity(8)
    elseif setthreadidentity then
        setthreadidentity(8)
    end
end)

local blockedKW = {
    "cheat","hack","exploit","esp","aim","anticheat","ac_",
    "report","kick","ban","detect","flag","suspicious","warn",
    "inject","memory","speed","fly","noclip","bypass"
}

local function IsBlocked(v)
    if type(v) ~= "string" then return false end
    local low = v:lower()
    for _, kw in ipairs(blockedKW) do
        if low:find(kw, 1, true) then return true end
    end
    return false
end

safeHook(function()
    local oldNC
    oldNC = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        if m == "Kick" then return end
        if m == "FireServer" or m == "InvokeServer" then
            for _, v in ipairs({...}) do
                if IsBlocked(tostring(v)) then return end
            end
        end
        -- RemoteEvent/Function block
        local ok,  isRE = pcall(function() return self:IsA("RemoteEvent") end)
        local ok2, isRF = pcall(function() return self:IsA("RemoteFunction") end)
        if (ok and isRE) or (ok2 and isRF) then
            if IsBlocked(self.Name) then return end
        end
        return oldNC(self, ...)
    end)
end)

safeHook(function()
    hookfunction(LocalPlayer.Kick, function() return end)
end)

safeHook(function()
    local TPS    = game:GetService("TeleportService")
    local origTp = TPS.Teleport
    hookfunction(origTp, function(self, placeId, ...)
        if placeId ~= game.PlaceId then return end
        return origTp(self, placeId, ...)
    end)
end)

safeHook(function()
    local oldIdx
    oldIdx = hookmetamethod(game, "__index", function(self, key)
        local val = oldIdx(self, key)
        if key == "Fire" then
            local ok, isB = pcall(function() return self:IsA("BindableEvent") end)
            if ok and isB and IsBlocked(self.Name) then
                return function() end
            end
        end
        return val
    end)
end)

local ScreenGui -- forward declare для rename task
task.spawn(function()
    while task.wait(20) do
        safeHook(function()
            if ScreenGui and ScreenGui.Parent then
                ScreenGui.Name = "Rbx_"..tostring(math.random(0x10000, 0xFFFFF))
            end
        end)
    end
end)

-- ═══════════════════════════════════════
-- [ 2 ] SETTINGS
-- ═══════════════════════════════════════
local Settings = {
    Aimbot = {
        Enabled        = false,
        Silent         = false,
        Distance       = 150,
        SilentDistance = 150,
        FOV            = 120,
        Smoothness     = 0.18,
        TeamCheck      = true,
        HitPart        = "Head",
        Key            = Enum.UserInputType.MouseButton2,
    },
    ESP = {
        Enabled     = false,
        Box         = true,
        Name        = true,
        Distance    = true,
        Health      = true,
        Weapon      = true,
        Chams       = false,
        TeamColor   = true,
        MaxDistance = 500,
    },
    Mobile = UserInputService.TouchEnabled,
}

-- ═══════════════════════════════════════
-- [ 3 ] UTILITIES
-- ═══════════════════════════════════════
local function GetRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function GetWeapon(char)
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then return v.Name end
    end
    return "None"
end

local function Alive(hum)
    return hum and hum.Health > 0
end

-- ─── ГЛАВНАЯ ПРОВЕРКА ВРАГА ───
local function IsEnemy(p)
    if not p or p == LocalPlayer then return false end

    if Settings.Aimbot.TeamCheck then
        local myTeam    = LocalPlayer.Team
        local theirTeam = p.Team

        -- FFA — оба без тима = враги
        if myTeam == nil and theirTeam == nil then
            return true
        end

        -- разные тимы = враг
        if myTeam ~= theirTeam then
            return true
        end

        -- одинаковый тим = свой
        return false
    end

    -- TeamCheck выключен — все враги
    return true
end

local function W2S(pos)
    local ok, p = pcall(function()
        return Camera:WorldToViewportPoint(pos)
    end)
    if ok and p then
        return Vector2.new(p.X, p.Y), p.Z > 0
    end
    return nil, false
end

-- ═══════════════════════════════════════
-- [ 4 ] FOV CIRCLE
-- ═══════════════════════════════════════
local FOVCircle = Drawing.new("Circle")
FOVCircle.Visible   = false
FOVCircle.Radius    = Settings.Aimbot.FOV
FOVCircle.Color     = Color3.fromRGB(255, 255, 255)
FOVCircle.Thickness = 1.5
FOVCircle.Filled    = false
FOVCircle.NumSides  = 64

-- ═══════════════════════════════════════
-- [ 5 ] AIMBOT TARGET
-- ═══════════════════════════════════════
local function BestTarget(silent)
    local best, bestD = nil, math.huge
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local maxW   = silent and Settings.Aimbot.SilentDistance or Settings.Aimbot.Distance

    for _, p in ipairs(Players:GetPlayers()) do
        if not IsEnemy(p) then continue end          -- team check тут

        local char = p.Character
        if not char then continue end
        local hum = GetHum(char)
        if not Alive(hum) then continue end
        local root = GetRoot(char)
        if not root then continue end
        if (root.Position - Camera.CFrame.Position).Magnitude > maxW then continue end

        local part = char:FindFirstChild(Settings.Aimbot.HitPart) or root
        local sc, on = W2S(part.Position)
        if not sc or not on then continue end

        local d = (sc - center).Magnitude
        if d < Settings.Aimbot.FOV and d < bestD then
            best  = part
            bestD = d
        end
    end
    return best
end

-- ═══════════════════════════════════════
-- [ 6 ] SILENT AIM
-- ═══════════════════════════════════════
safeHook(function()
    local oldHook
    oldHook = hookmetamethod(game, "__index", function(self, key)
        if key == "Hit" then
            local ok, isMouse = pcall(function()
                return self == LocalPlayer:GetMouse()
            end)
            if ok and isMouse and Settings.Aimbot.Silent and Settings.Aimbot.Enabled then
                local t = BestTarget(true) -- уже фильтрует своих
                if t then return CFrame.new(t.Position) end
            end
        end
        return oldHook(self, key)
    end)
end)

-- ═══════════════════════════════════════
-- [ 7 ] ESP POOL
-- ═══════════════════════════════════════
local ESPPool   = {}
local ChamsPool = {}

local function NewDraw(t, props)
    local d = Drawing.new(t)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function MakeESP(p)
    if p == LocalPlayer then return end
    ESPPool[p] = {
        Box    = NewDraw("Square", {Visible=false, Filled=false, Thickness=1.5}),
        HBar   = NewDraw("Square", {Visible=false, Filled=true,  Color=Color3.fromRGB(20,20,20)}),
        HFill  = NewDraw("Square", {Visible=false, Filled=true,  Color=Color3.fromRGB(80,255,80)}),
        Name   = NewDraw("Text",   {Visible=false, Size=13, Center=true, Outline=true, Color=Color3.fromRGB(255,255,255)}),
        Dist   = NewDraw("Text",   {Visible=false, Size=12, Center=true, Outline=true, Color=Color3.fromRGB(200,200,200)}),
        HP     = NewDraw("Text",   {Visible=false, Size=12, Center=true, Outline=true, Color=Color3.fromRGB(80,255,80)}),
        Weapon = NewDraw("Text",   {Visible=false, Size=12, Center=true, Outline=true, Color=Color3.fromRGB(255,200,60)}),
    }
end

local function RemoveESP(p)
    if ESPPool[p] then
        for _, d in pairs(ESPPool[p]) do pcall(function() d:Remove() end) end
        ESPPool[p] = nil
    end
end

local function ApplyChams(char, col)
    if ChamsPool[char] then return end
    ChamsPool[char] = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            local b = Instance.new("SelectionBox")
            b.Color3              = col
            b.SurfaceColor3       = col
            b.SurfaceTransparency = 0.45
            b.LineThickness       = 0.03
            b.Adornee             = part
            b.Parent              = workspace
            table.insert(ChamsPool[char], b)
        end
    end
end

local function RemoveChams(char)
    if ChamsPool[char] then
        for _, b in ipairs(ChamsPool[char]) do
            pcall(function() b:Destroy() end)
        end
        ChamsPool[char] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do MakeESP(p) end
Players.PlayerAdded:Connect(MakeESP)
Players.PlayerRemoving:Connect(function(p)
    RemoveESP(p)
    if p.Character then RemoveChams(p.Character) end
end)

-- ═══════════════════════════════════════
-- [ 8 ] MAIN LOOP
-- ═══════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)

    -- FOV
    FOVCircle.Position = center
    FOVCircle.Radius   = Settings.Aimbot.FOV
    FOVCircle.Visible  = Settings.Aimbot.Enabled and not Settings.Aimbot.Silent

    -- Aimbot PC
    if Settings.Aimbot.Enabled and not Settings.Aimbot.Silent then
        if UserInputService:IsMouseButtonPressed(Settings.Aimbot.Key) then
            local t = BestTarget(false)
            if t then
                local sc, on = W2S(t.Position)
                if on and sc then
                    local mouse = UserInputService:GetMouseLocation()
                    local delta = sc - mouse
                    mousemoverel(
                        delta.X * Settings.Aimbot.Smoothness,
                        delta.Y * Settings.Aimbot.Smoothness
                    )
                end
            end
        end
    end

    -- ESP
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local obj = ESPPool[p]
        if not obj then continue end

        local char = p.Character
        local hum  = char and GetHum(char)
        local root = char and GetRoot(char)

        -- ─── СВОЙ ИГРОК — скрываем всё ───
        if not IsEnemy(p) then
            for _, d in pairs(obj) do d.Visible = false end
            if char then RemoveChams(char) end
            continue
        end

        if not char or not hum or not root or not Alive(hum) then
            for _, d in pairs(obj) do d.Visible = false end
            if char then RemoveChams(char) end
            continue
        end

        local worldD = (root.Position - Camera.CFrame.Position).Magnitude
        if worldD > Settings.ESP.MaxDistance then
            for _, d in pairs(obj) do d.Visible = false end
            continue
        end

        -- Team color
        local tCol = Settings.ESP.TeamColor
            and Color3.fromRGB(255, 60, 60)   -- враг всегда красный
            or  Color3.fromRGB(255, 60, 60)

        -- Chams
        if Settings.ESP.Chams then
            ApplyChams(char, tCol)
        else
            RemoveChams(char)
        end

        if not Settings.ESP.Enabled then
            for _, d in pairs(obj) do d.Visible = false end
            continue
        end

        -- Box calc
        local top, tOn = W2S(root.Position + Vector3.new(0, 3.2, 0))
        local bot, bOn = W2S(root.Position - Vector3.new(0, 3.2, 0))
        if not tOn or not bOn or not top or not bot then
            for _, d in pairs(obj) do d.Visible = false end
            continue
        end

        local h  = math.abs(top.Y - bot.Y)
        local w  = h * 0.55
        local bx = top.X - w / 2
        local by = top.Y

        obj.Box.Visible  = Settings.ESP.Box
        obj.Box.Position = Vector2.new(bx, by)
        obj.Box.Size     = Vector2.new(w, h)
        obj.Box.Color    = tCol

        local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        obj.HBar.Visible  = true
        obj.HBar.Position = Vector2.new(bx - 6, by)
        obj.HBar.Size     = Vector2.new(4, h)
        obj.HFill.Visible  = true
        obj.HFill.Position = Vector2.new(bx - 6, by + h * (1 - hp))
        obj.HFill.Size     = Vector2.new(4, h * hp)
        obj.HFill.Color    = Color3.fromRGB(
            math.floor(255 * (1 - hp)),
            math.floor(255 * hp),
            0
        )

        obj.Name.Visible  = Settings.ESP.Name
        obj.Name.Text     = p.Name
        obj.Name.Position = Vector2.new(top.X, by - 15)

        obj.Dist.Visible  = Settings.ESP.Distance
        obj.Dist.Text     = string.format("[%.0fm]", worldD)
        obj.Dist.Position = Vector2.new(top.X, by + h + 2)

        obj.HP.Visible    = Settings.ESP.Health
        obj.HP.Text       = string.format("HP %.0f", hum.Health)
        obj.HP.Position   = Vector2.new(top.X, by + h + 14)

        obj.Weapon.Visible  = Settings.ESP.Weapon
        obj.Weapon.Text     = GetWeapon(char)
        obj.Weapon.Position = Vector2.new(top.X, by + h + 26)
    end
end)

