-- ─── HELPERS ───
local Tabs = {}

local function MakeScroll(parent)
    local s = Instance.new("ScrollingFrame")
    s.Size                  = UDim2.new(1, 0, 1, 0)
    s.BackgroundTransparency = 1
    s.BorderSizePixel       = 0
    s.ScrollBarThickness    = 3
    s.ScrollBarImageColor3  = Color3.fromRGB(70, 70, 140)
    s.AutomaticCanvasSize   = Enum.AutomaticSize.Y
    s.CanvasSize            = UDim2.new(0, 0, 0, 0)
    s.Parent                = parent
    local ul = Instance.new("UIListLayout", s)
    ul.Padding    = UDim.new(0, 7)
    ul.SortOrder  = Enum.SortOrder.LayoutOrder
    local pad = Instance.new("UIPadding", s)
    pad.PaddingLeft  = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    pad.PaddingTop   = UDim.new(0, 8)
    return s
end

local function MakeTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0, 96, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(14, 14, 24)
    btn.BorderSizePixel  = 0
    btn.Text             = icon.." "..name
    btn.TextColor3       = Color3.fromRGB(110, 110, 170)
    btn.Font             = Enum.Font.GothamSemibold
    btn.TextSize         = 12
    btn.Parent           = TabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("Frame")
    page.Size                = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible             = false
    page.Parent              = Content

    local scroll = MakeScroll(page)
    Tabs[name] = {Btn=btn, Page=page, Scroll=scroll}

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(Tabs) do
            t.Page.Visible       = false
            t.Btn.BackgroundColor3 = Color3.fromRGB(14, 14, 24)
            t.Btn.TextColor3     = Color3.fromRGB(110, 110, 170)
        end
        page.Visible         = true
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 52)
        btn.TextColor3       = Color3.fromRGB(220, 220, 255)
    end)

    -- touch поддержка таба
    btn.Activated:Connect(function()
        for _, t in pairs(Tabs) do
            t.Page.Visible       = false
            t.Btn.BackgroundColor3 = Color3.fromRGB(14, 14, 24)
            t.Btn.TextColor3     = Color3.fromRGB(110, 110, 170)
        end
        page.Visible         = true
        btn.BackgroundColor3 = Color3.fromRGB(28, 28, 52)
        btn.TextColor3       = Color3.fromRGB(220, 220, 255)
    end)

    return Tabs[name]
end

local function Sep(parent, text)
    local f = Instance.new("Frame")
    f.Size                = UDim2.new(1, 0, 0, 16)
    f.BackgroundTransparency = 1
    f.Parent              = parent
    local l = Instance.new("TextLabel")
    l.Size             = UDim2.new(1, 0, 1, 0)
    l.BackgroundTransparency = 1
    l.Text             = "─── "..text.." ───"
    l.TextColor3       = Color3.fromRGB(70, 70, 140)
    l.Font             = Enum.Font.GothamBold
    l.TextSize         = 11
    l.TextXAlignment   = Enum.TextXAlignment.Left
    l.Parent           = f
end

local function Toggle(parent, label, default, cb)
    local row = Instance.new("Frame")
    row.Size                = UDim2.new(1, 0, 0, 26)
    row.BackgroundTransparency = 1
    row.Parent              = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(0.75, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label
    lbl.TextColor3       = Color3.fromRGB(190, 190, 215)
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 12
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Parent           = row

    local bg = Instance.new("Frame")
    bg.Size             = UDim2.new(0, 36, 0, 18)
    bg.Position         = UDim2.new(1, -36, 0.5, -9)
    bg.BackgroundColor3 = default and Color3.fromRGB(70, 70, 200) or Color3.fromRGB(45, 45, 55)
    bg.Parent           = row
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Parent           = bg
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = default
    local btn = Instance.new("TextButton")
    btn.Size                = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text                = ""
    btn.Parent              = row

    local function flip()
        state = not state
        bg.BackgroundColor3 = state and Color3.fromRGB(70, 70, 200) or Color3.fromRGB(45, 45, 55)
        knob.Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        cb(state)
    end

    btn.MouseButton1Click:Connect(flip)
    btn.Activated:Connect(flip) -- touch
end

local function Slider(parent, label, min, max, default, cb)
    local wrap = Instance.new("Frame")
    wrap.Size                = UDim2.new(1, 0, 0, 42)
    wrap.BackgroundTransparency = 1
    wrap.Parent              = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label..":  "..default
    lbl.TextColor3       = Color3.fromRGB(180, 180, 205)
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 12
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Parent           = wrap

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, 0, 0, 5)
    track.Position         = UDim2.new(0, 0, 0, 24)
    track.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
    track.Parent           = wrap
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new((default-min)/(max-min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(70, 70, 200)
    fill.Parent           = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local handle = Instance.new("Frame")
    handle.Size             = UDim2.new(0, 11, 0, 11)
    handle.Position         = UDim2.new((default-min)/(max-min), -5, 0.5, -5)
    handle.BackgroundColor3 = Color3.fromRGB(190, 190, 255)
    handle.Parent           = track
    Instance.new("UICorner", handle).CornerRadius = UDim.new(1, 0)

    local draggingS = false
    local function Upd(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + rel * (max - min))
        fill.Size       = UDim2.new(rel, 0, 1, 0)
        handle.Position = UDim2.new(rel, -5, 0.5, -5)
        lbl.Text        = label..":  "..val
        cb(val)
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            draggingS = true
            Upd(i.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingS and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            Upd(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            draggingS = false
        end
    end)
end

-- ─── BUILD TABS ───
local tAim = MakeTab("AIM", "🎯")
local tESP = MakeTab("ESP", "👁")

-- AIM tab
local aS = tAim.Scroll
Sep(aS, "Aimbot")
Toggle(aS, "Enable Aimbot", false, function(v) Settings.Aimbot.Enabled = v end)
Slider(aS, "Aim Distance",  0, 300, 150, function(v) Settings.Aimbot.Distance = v end)
Slider(aS, "FOV",           0, 250, 120, function(v) Settings.Aimbot.FOV = v end)
Sep(aS, "Silent Aim")
Toggle(aS, "Enable Silent", false, function(v) Settings.Aimbot.Silent = v end)
Slider(aS, "Silent Distance", 0, 300, 150, function(v) Settings.Aimbot.SilentDistance = v end)
Sep(aS, "Options")
Toggle(aS, "Team Check", true, function(v) Settings.Aimbot.TeamCheck = v end)

-- ESP tab
local eS = tESP.Scroll
Sep(eS, "ESP")
Toggle(eS, "Enable ESP", false, function(v) Settings.ESP.Enabled = v end)
Toggle(eS, "Box",         true,  function(v) Settings.ESP.Box = v end)
Sep(eS, "Chams")
Toggle(eS, "Enable Chams", false, function(v)
    Settings.ESP.Chams = v
    if not v then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then RemoveChams(p.Character) end
        end
    end
end)
Toggle(eS, "Team Colors", true, function(v) Settings.ESP.TeamColor = v end)
Sep(eS, "Labels")
Toggle(eS, "Name",     true, function(v) Settings.ESP.Name = v end)
Toggle(eS, "Distance", true, function(v) Settings.ESP.Distance = v end)
Toggle(eS, "Health",   true, function(v) Settings.ESP.Health = v end)
Toggle(eS, "Weapon",   true, function(v) Settings.ESP.Weapon = v end)

-- open first tab
Tabs["AIM"].Btn:Activate()

-- ─── PC HIDE TOGGLE ───
UserInputService.InputBegan:Connect(function(i)
    if i.KeyCode == Enum.KeyCode.RightShift then
        Main.Visible = not Main.Visible
    end
end)

-- ═══════════════════════════════════════
-- [ 10 ] MOBILE FLOATING "L" BUTTON
-- ═══════════════════════════════════════
if Settings.Mobile then
    local FloatBtn = Instance.new("TextButton")
    FloatBtn.Size             = UDim2.new(0, 48, 0, 48)
    FloatBtn.Position         = UDim2.new(0, 16, 0.5, -24)
    FloatBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 52)
    FloatBtn.Text             = "L"
    FloatBtn.TextColor3       = Color3.fromRGB(210, 210, 255)
    FloatBtn.Font             = Enum.Font.GothamBold
    FloatBtn.TextSize         = 20
    FloatBtn.ZIndex           = 999
    FloatBtn.Parent           = ScreenGui
    Instance.new("UICorner", FloatBtn).CornerRadius = UDim.new(1, 0)
    local fs = Instance.new("UIStroke", FloatBtn)
    fs.Color     = Color3.fromRGB(70, 70, 200)
    fs.Thickness = 2

    -- drag floating button
    local fbDrag, fbStart, fbPos = false, nil, nil
    FloatBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            fbDrag = true
            fbStart = i.Position
            fbPos   = FloatBtn.Position
        end
    end)
    FloatBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then
            fbDrag = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if fbDrag and i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - fbStart
            FloatBtn.Position = UDim2.new(
                fbPos.X.Scale, fbPos.X.Offset + d.X,
                fbPos.Y.Scale, fbPos.Y.Offset + d.Y
            )
        end
    end)

    FloatBtn.Activated:Connect(function()
        Main.Visible = not Main.Visible
        FloatBtn.BackgroundColor3 = Main.Visible
            and Color3.fromRGB(70, 70, 200)
            or  Color3.fromRGB(28, 28, 52)
    end)
end
