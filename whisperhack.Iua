-- ===== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =====
function OpenMenu()
    MainFrame.Visible = true
    Background.Visible = true
    UpdateContent()
end

function CloseMenu()
    MainFrame.Visible = false
    Background.Visible = false
end

function ToggleMenu()
    if MainFrame.Visible then
        CloseMenu()
    else
        OpenMenu()
    end
end

function ResetMenuPosition()
    MainFrame.Position = UDim2.new(0.04, 0, 0.1, 0)
end

function MinimizeMenu()
    MainFrame.Size = UDim2.new(0.2, 0, 0.1, 0)
end

function MaximizeMenu()
    MainFrame.Size = UDim2.new(0.92, 0, 0.8, 0)
end

function ResetControls()
    Settings.MenuKey = "F1"
    Settings.AimKey = "MouseButton2"
    Settings.ESPKey = "F2"
    Settings.FlyKey = "F3"
    Settings.SpeedKey = "F4"
    Settings.TeleportKey = "F5"
    Settings.NoClipKey = "F6"
    Settings.TriggerKey = "MouseButton1"
    Settings.SwipeOpen = true
    Settings.SwipeClose = true
    Settings.SwipeSensitivity = 100
end

