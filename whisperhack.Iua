-- ===== ОБНОВЛЕНИЕ МЕНЮ =====
function UpdateContent()
    for _, child in pairs(ContentFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("ScrollingFrame") then
            child:Destroy()
        end
    end
    
    if CurrentTab == "ESP" then
        CreateESPTab()
    elseif CurrentTab == "AIM" then
        CreateAimTab()
    elseif CurrentTab == "VISUALS" then
        CreateVisualsTab()
    elseif CurrentTab == "MISC" then
        CreateMiscTab()
    elseif CurrentTab == "SOUNDS" then
        CreateSoundsTab()
    elseif CurrentTab == "CONTROLS" then
        CreateControlsTab()
    elseif CurrentTab == "EXTRA" then
        CreateExtraTab()
    end
end

-- ===== ОПТИМИЗАЦИЯ ДЛЯ МОБИЛЫ =====
if IsMobile then
    -- Уменьшаем размер кнопок
    local function ResizeForMobile()
        MainFrame.Size = UDim2.new(0.95, 0, 0.9, 0)
        MainFrame.Position = UDim2.new(0.025, 0, 0.05, 0)
        
        -- Увеличиваем шрифт
        for _, child in pairs(MainFrame:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                child.TextScaled = true
            end
        end
    end
    ResizeForMobile()
    
    -- Отключаем тяжелые функции на мобиле
    Settings.ShowSkeleton = false
    Settings.ShowChams = false
    Settings.ShowTrails = false
    Settings.ShowParticles = false
    Settings.ShowShadows = false
end

