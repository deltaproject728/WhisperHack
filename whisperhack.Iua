-- ============================================
-- BBC ULTIMATE v6.0 - МАКСИМАЛЬНАЯ ОПТИМИЗАЦИЯ
-- Поддержка ПК + Mobile (FPS 60+ на слабых устройствах)
-- ============================================

-- ===== ОПРЕДЕЛЯЕМ УСТРОЙСТВО =====
local UserInputService = game:GetService("UserInputService")
local IsMobile = UserInputService.TouchEnabled
local IsPC = not IsMobile

-- ===== НАСТРОЙКИ ПРОИЗВОДИТЕЛЬНОСТИ =====
local Performance = {
    -- Режимы оптимизации
    Mode = "Auto", -- Auto, Performance, Balanced, Quality
    
    -- Ограничения
    MaxESPObjects = IsMobile and 20 or 50,
    MaxLootObjects = IsMobile and 10 or 30,
    UpdateRate = IsMobile and 0.1 or 0.05,
    RenderDistance = IsMobile and 200 or 500,
    FOVUpdateRate = IsMobile and 0.2 or 0.05,
    
    -- Отключение тяжелых функций на мобиле
    DisableTrails = IsMobile,
    DisableChams = IsMobile,
    DisableSkeleton = IsMobile,
    DisableParticles = IsMobile,
    DisableShadows = IsMobile,
    
    -- Качество
    GraphicsQuality = IsMobile and "Low" or "High",
    ESPQuality = IsMobile and "Low" or "High",
}

-- ===== АВТО-НАСТРОЙКА ПОД УСТРОЙСТВО =====
local function AutoOptimize()
    local fps = game:GetService("Stats").Fps
    local memory = game:GetService("Stats").Memory
    
    if IsMobile then
        -- Мобильные настройки
        Performance.MaxESPObjects = 15
        Performance.MaxLootObjects = 8
        Performance.UpdateRate = 0.15
        Performance.RenderDistance = 150
        Performance.DisableTrails = true
        Performance.DisableChams = true
        Performance.DisableSkeleton = true
        Performance.DisableParticles = true
        Performance.DisableShadows = true
        Performance.GraphicsQuality = "Low"
        Performance.ESPQuality = "Low"
        
        -- Отключаем тяжелые визуалы
        VisualsSettings.NoFoliage = true
        VisualsSettings.NoGrass = true
        VisualsSettings.NoParticles = true
        VisualsSettings.NoShadows = true
        VisualsSettings.LowGraphics = true
        
        -- Уменьшаем FOV круг
        if FOVCircle then
            FOVCircle.NumSides = 32
        end
    else
        -- ПК настройки (высокое качество)
        Performance.MaxESPObjects = 50
        Performance.MaxLootObjects = 30
        Performance.UpdateRate = 0.05
        Performance.RenderDistance = 500
        Performance.DisableTrails = false
        Performance.DisableChams = false
        Performance.DisableSkeleton = false
        Performance.DisableParticles = false
        Performance.DisableShadows = false
        Performance.GraphicsQuality = "High"
        Performance.ESPQuality = "High"
    end
end

-- ===== СИСТЕМА КЭШИРОВАНИЯ =====
local Cache = {
    Players = {},
    Characters = {},
    ESPObjects = {},
    LootObjects = {},
    LastUpdate = 0,
}

-- ===== ОГРАНИЧЕНИЕ ЧАСТОТЫ ОБНОВЛЕНИЯ =====
local function Throttle(func, delay)
    local lastCall = 0
    return function(...)
        local now = tick()
        if now - lastCall >= delay then
            lastCall = now
            return func(...)
        end
    end
end

-- ===== ОПТИМИЗИРОВАННЫЙ ПОИСК ИГРОКОВ =====
local function GetPlayersOptimized()
    local now = tick()
    if now - Cache.LastUpdate < Performance.UpdateRate then
        return Cache.Players
    end
    
    Cache.LastUpdate = now
    Cache.Players = {}
    
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= Player then
            local char = v.Character
            if char and char:FindFirstChild("Humanoid") then
                local humanoid = char.Humanoid
                if humanoid.Health > 0 then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = (root.Position - Character.HumanoidRootPart.Position).Magnitude
                        if dist <= Performance.RenderDistance then
                            table.insert(Cache.Players, {
                                Player = v,
                                Character = char,
                                Humanoid = humanoid,
                                Root = root,
                                Distance = dist,
                            })
                        end
                    end
                end
            end
        end
    end
    
    return Cache.Players
end

-- ===== ОПТИМИЗИРОВАННЫЙ ESP =====
local function OptimizedESP()
    if not Settings.ESP then 
        ClearESPObjects()
        return 
    end
    
    local players = GetPlayersOptimized()
    
    -- Очищаем старые объекты
    ClearESPObjects()
    
    -- Создаем новые (с ограничением)
    local count = 0
    for _, data in pairs(players) do
        if count >= Performance.MaxESPObjects then break end
        
        local char = data.Character
        local color = Settings.PlayerColor or Color3.fromRGB(255, 0, 0)
        
        -- Только основные ESP на мобиле
        if IsMobile then
            -- Упрощенный ESP (только Highlight)
            local highlight = Instance.new("Highlight")
            highlight.Parent = char
            highlight.FillColor = color
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.3
            table.insert(Cache.ESPObjects, highlight)
        else
            -- Полный ESP на ПК
            if Settings.ShowBox then
                local box = CreateBox(char, color)
                if box then table.insert(Cache.ESPObjects, box) end
            end
            
            if Settings.ShowName or Settings.ShowHealth then
                local info = CreateInfoLabel(char, color)
                if info then table.insert(Cache.ESPObjects, info) end
            end
            
            if Settings.ShowSkeleton and not Performance.DisableSkeleton then
                local skeleton = CreateSkeleton(char, color)
                if skeleton then table.insert(Cache.ESPObjects, skeleton) end
            end
        end
        
        count = count + 1
    end
end

-- ===== ОПТИМИЗИРОВАННЫЙ AIMBOT =====
local function OptimizedAimbot()
    if not Settings.Aimbot then return end
    
    local players = GetPlayersOptimized()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestTarget = nil
    local bestDist = math.huge
    
    for _, data in pairs(players) do
        local char = data.Character
        local hitbox = char:FindFirstChild(Settings.Hitbox) or char:FindFirstChild("HumanoidRootPart")
        if not hitbox then continue end
        
        local targetPos = hitbox.Position
        
        -- Предсказание (упрощенное на мобиле)
        if Settings.Prediction and not IsMobile then
            local velocity = hitbox.Velocity
            targetPos = targetPos + (velocity * Settings.PredictionAmount)
        end
        
        local screenPos, onScreen = Camera:WorldToScreenPoint(targetPos)
        if not onScreen then continue end
        
        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
        local dist = (screenPos2D - center).Magnitude
        
        if dist > Settings.FOV then continue end
        
        if dist < bestDist then
            bestDist = dist
            bestTarget = {
                Character = char,
                Position = targetPos,
                Hitbox = hitbox,
                Distance = data.Distance,
            }
        end
    end
    
    return bestTarget
end

-- ===== ОЧИСТКА ОБЪЕКТОВ =====
local function ClearESPObjects()
    for _, obj in pairs(Cache.ESPObjects) do
        pcall(function() obj:Destroy() end)
    end
    Cache.ESPObjects = {}
end

-- ===== ОПТИМИЗИРОВАННОЕ ОБНОВЛЕНИЕ =====
local function OptimizedUpdate()
    -- Обновляем ESP
    if Settings.ESP then
        OptimizedESP()
    end
    
    -- Обновляем Aimbot
    if Settings.Aimbot then
        local target = OptimizedAimbot()
        if target then
            -- Применяем аим (упрощенный на мобиле)
            if IsMobile then
                -- Мобильный аим (только Silent Aim)
                local weapon = Character:FindFirstChildOfClass("Tool")
                if weapon and weapon:FindFirstChild("Handle") then
                    weapon.Handle.CFrame = CFrame.lookAt(weapon.Handle.Position, target.Position)
                end
            else
                -- ПК аим (полный)
                local origin = Camera.CFrame.Position
                local targetCF = CFrame.lookAt(origin, target.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCF, Settings.Smoothness / 100)
            end
        end
    end
end

-- ===== РЕЖИМЫ ПРОИЗВОДИТЕЛЬНОСТИ =====
local function SetPerformanceMode(mode)
    Performance.Mode = mode
    
    if mode == "Performance" then
        -- Максимальная производительность
        Performance.MaxESPObjects = IsMobile and 10 or 30
        Performance.UpdateRate = IsMobile and 0.2 or 0.1
        Performance.RenderDistance = IsMobile and 100 or 300
        Performance.DisableTrails = true
        Performance.DisableChams = true
        Performance.DisableSkeleton = true
        Performance.DisableParticles = true
        Performance.DisableShadows = true
        VisualsSettings.LowGraphics = true
        VisualsSettings.NoFoliage = true
        VisualsSettings.NoGrass = true
        
    elseif mode == "Balanced" then
        -- Сбалансированный режим
        Performance.MaxESPObjects = IsMobile and 15 or 40
        Performance.UpdateRate = IsMobile and 0.15 or 0.075
        Performance.RenderDistance = IsMobile and 150 or 400
        Performance.DisableTrails = IsMobile
        Performance.DisableChams = IsMobile
        Performance.DisableSkeleton = IsMobile
        Performance.DisableParticles = IsMobile
        Performance.DisableShadows = IsMobile
        VisualsSettings.LowGraphics = IsMobile
        VisualsSettings.NoFoliage = IsMobile
        
    elseif mode == "Quality" then
        -- Максимальное качество
        Performance.MaxESPObjects = IsMobile and 20 or 50
        Performance.UpdateRate = IsMobile and 0.1 or 0.05
        Performance.RenderDistance = IsMobile and 200 or 500
        Performance.DisableTrails = false
        Performance.DisableChams = false
        Performance.DisableSkeleton = false
        Performance.DisableParticles = false
        Performance.DisableShadows = false
        VisualsSettings.LowGraphics = false
        VisualsSettings.NoFoliage = false
        VisualsSettings.NoGrass = false
        
    else -- Auto
        AutoOptimize()
    end
end

-- ===== ЗАПУСК ОПТИМИЗАЦИИ =====
AutoOptimize()

-- ===== ЦИКЛ ОБНОВЛЕНИЯ (С ТРОТТЛИНГОМ) =====
local throttledUpdate = Throttle(OptimizedUpdate, Performance.UpdateRate)

RunService.Heartbeat:Connect(function()
    throttledUpdate()
end)

