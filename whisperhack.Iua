    ["Ambient Sounds"] = {type = "toggle", default = false, callback = function(val) Settings.AmbientSounds = val end},
    ["Sound Delay"] = {type = "slider", min = 0, max = 500, default = 50, callback = function(val) Settings.SoundDelay = val / 1000 end},
    
    -- Дополнительно (5)
    ["Voice Lines"] = {type = "toggle", default = false, callback = function(val) Settings.VoiceLines = val end},
    ["Music on Kill"] = {type = "toggle", default = false, callback = function(val) Settings.MusicOnKill = val end},
    ["Custom Sound URL"] = {type = "input", default = "", callback = function(val) Settings.CustomSound = val end},
    ["Import Sound"] = {type = "button", callback = function() 
        -- Импорт пользовательского звука
        if Settings.CustomSound ~= "" then
            SoundPack["Custom"] = {soundId = Settings.CustomSound, volume = Settings.Volume}
            CurrentSoundPack = "Custom"
        end
    end},
    ["Reset Sounds"] = {type = "button", callback = function() 
        Settings.Volume = 0.8
        Settings.Pitch = 1
        Settings.HeadshotSound = true
        Settings.KillSound = true
        CurrentSoundPack = "CS:GO"
        game.StarterGui:SetCore("SendNotification", {Title = "Sounds Reset", Text = "All sounds reset to default", Duration = 2})
    end},
}

